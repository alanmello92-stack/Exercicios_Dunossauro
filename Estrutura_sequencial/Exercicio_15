valor_hora = float(input("Digite o valor de sua hora de trabalho: "))

print("\n")

hora_trabalhada = int(input("Digite quantas horas trabalhou: "))

print("\n")

salario_bruto = valor_hora * hora_trabalhada
if salario_bruto > 5000:
    ir = (salario_bruto / 100) * 11
    inss = (salario_bruto / 100) * 7.5
    sindicato = salario_bruto / 30
    
else:
     ir = 0
     inss = (salario_bruto / 100) * 7.5
     sindicato = salario_bruto / 30
     
salario_liquido = salario_bruto - ir - inss - sindicato


print(f" + Salário Bruto : R$ {salario_bruto}")
#print("\n")
print(f" - IR (11%) : R$ {ir}")
#print("\n")
print(f"- INSS (7.5%) : R$ {inss}")
#print("\n")
print(f"- Sindicato (Equivale a um dia de trabalho do salario bruto) : R$ {sindicato}")
#print("\n")
print(f"= Salário Liquido : R$ {salario_liquido}")
